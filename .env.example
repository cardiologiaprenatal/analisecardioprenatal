# Microsserviço FastAPI (ML) — CardioPrenatal
# Laravel/nginx usa a porta 8000; este serviço usa 8010.

HOST=0.0.0.0
PORT=8010
MODEL_PATH=models/best_model.joblib
DATASET_PATH=dataset_com_id_gestante.csv
METRICS_PATH=data/metricas_modelos.csv
APP_NAME=CardioPrenatal-ML
APP_VERSION=1.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Segurança — chave compartilhada com o Laravel (obrigatória em produção)
# Header: X-API-Key: <valor>   OU   Authorization: Bearer <valor>
# Se vazio, a auth fica DESLIGADA (apenas desenvolvimento).
API_KEY=

# Interpretação clínica — Fase 1 (Gemini)
# Vertex AI (preferencial em produção):
INTERPRETACAO_VERTEX_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
# Alternativa local: API key Gemini (sem Vertex)
GOOGLE_API_KEY=
# Se Gemini falhar, devolve mock (true) ou erro 502 (false)
INTERPRETACAO_FALLBACK_MOCK=true
# ADC: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
